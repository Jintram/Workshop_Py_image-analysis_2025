      "source": [
        "---\n",
        "title: Workshop Python Image Analysis\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "\n",
        "*Martijn Wehrens, September 2025*\n",
        "\n",
        "## Answers to exercises 05\n"
      ],
      "id": "2c17f47e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tifffile as tiff\n",
        "\n",
        "import skimage as sk\n",
        "from skimage.util import invert\n",
        "from scipy import ndimage"
      ],
      "id": "60b18b2f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## E. coli pipeline\n",
        "\n",
        "Below we re-use the more advanced building-block strategy from the chapter and\n",
        "wrap it in a loop over all frames.\n"
      ],
      "id": "3bf8c6fc"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def _global_mask(input_img, disksize_range=20):\n",
        "\timg_min = ndimage.minimum_filter(input_img, footprint=sk.morphology.disk(disksize_range))\n",
        "\timg_max = ndimage.maximum_filter(input_img, footprint=sk.morphology.disk(disksize_range))\n",
        "\timg_delta = img_max - img_min\n",
        "\n",
        "\tthresh = sk.filters.threshold_otsu(img_delta)\n",
        "\tmask_global = img_delta > thresh\n",
        "\tmask_global_fill = ndimage.binary_fill_holes(mask_global)\n",
        "\n",
        "\tlabeled_global = sk.measure.label(mask_global_fill)\n",
        "\tlargest_region = np.argmax([r.area for r in sk.measure.regionprops(labeled_global)]) + 1\n",
        "\tmask_global_filled = labeled_global == largest_region\n",
        "\n",
        "\tdisksize_shrink = max(0, disksize_range - 5)\n",
        "\tmask_global_final = sk.morphology.erosion(\n",
        "\t\tmask_global_filled,\n",
        "\t\tfootprint=sk.morphology.disk(disksize_shrink),\n",
        "\t)\n",
        "\n",
        "\tbbox = sk.measure.regionprops(mask_global_final.astype(int))[0].bbox\n",
        "\treturn mask_global_final, bbox\n",
        "\n",
        "\n",
        "def _get_edges(input_img_crop, sigma_smooth=3, disksize_crossing=1):\n",
        "\timg_gauss = sk.filters.gaussian(input_img_crop, sigma=sigma_smooth)\n",
        "\timg_laplacian = sk.filters.laplace(img_gauss)\n",
        "\n",
        "\tedges_min = ndimage.minimum_filter(img_laplacian, footprint=sk.morphology.disk(disksize_crossing))\n",
        "\tedges_max = ndimage.maximum_filter(img_laplacian, footprint=sk.morphology.disk(disksize_crossing))\n",
        "\treturn np.logical_and(edges_min < 0, edges_max > 0)\n",
        "\n",
        "\n",
        "def _bacterial_seeds(input_img_crop, min_distance=5):\n",
        "\timg_smooth = sk.filters.gaussian(input_img_crop, sigma=3)\n",
        "\treturn sk.feature.peak_local_max(img_smooth, min_distance=min_distance)\n",
        "\n",
        "\n",
        "def _flood_fill_multiple(mask_edges, seed_locations):\n",
        "\tmask_filled = mask_edges.copy()\n",
        "\tfor x, y in seed_locations:\n",
        "\t\tmask_filled = sk.morphology.flood_fill(mask_filled, (x, y), 2)\n",
        "\treturn mask_filled\n",
        "\n",
        "\n",
        "def _unique_seeds_distance(mask_bacteria, sigma_seed=3, distance_threshold=3):\n",
        "\tdistance_map = ndimage.distance_transform_edt(mask_bacteria)\n",
        "\tdistance_map_blur = sk.filters.gaussian(distance_map, sigma=sigma_seed)\n",
        "\tmask_seeds = distance_map_blur > distance_threshold\n",
        "\treturn sk.measure.label(mask_seeds)\n",
        "\n",
        "\n",
        "def seg_bacterium(input_img):\n",
        "\tmask_global, bbox = _global_mask(input_img, disksize_range=20)\n",
        "\tinput_img_crop = input_img[bbox[0]:bbox[2], bbox[1]:bbox[3]]\n",
        "\tmask_global_crop = mask_global[bbox[0]:bbox[2], bbox[1]:bbox[3]]\n",
        "\n",
        "\tmask_edges = _get_edges(input_img_crop, sigma_smooth=3, disksize_crossing=1)\n",
        "\tseed_locations = _bacterial_seeds(input_img_crop, min_distance=5)\n",
        "\tmask_filled = _flood_fill_multiple(mask_edges, seed_locations)\n",
        "\tmask_bacteria = np.logical_and(mask_filled, mask_global_crop)\n",
        "\n",
        "\tmask_unique_seeds = _unique_seeds_distance(mask_bacteria, sigma_seed=3, distance_threshold=3)\n",
        "\tresult = sk.segmentation.watershed(-1 * mask_bacteria, markers=mask_unique_seeds, mask=mask_bacteria)\n",
        "\treturn result"
      ],
      "id": "03a15ad8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Put the location of the data here.\n",
        "path_ecoli_data = \"/Users/m.wehrens/Data_notbacked/2025_Py-Image-workshop_Filamentation-example-data/pos3crop_timelapse_switch890.98.tif\"\n",
        "\n",
        "# Load data and run segmentation over all timepoints\n",
        "imgs_ecoli = tiff.imread(path_ecoli_data)\n",
        "\n",
        "ecoli_masks = []\n",
        "ecoli_mean_area = []\n",
        "\n",
        "for t in range(imgs_ecoli.shape[0]):\n",
        "\tmask_t = seg_bacterium(invert(imgs_ecoli[t]))\n",
        "\tecoli_masks.append(mask_t)\n",
        "\n",
        "\tprops_t = sk.measure.regionprops(mask_t)\n",
        "\tareas_t = np.array([p.area for p in props_t])\n",
        "\tecoli_mean_area.append(np.mean(areas_t) if len(areas_t) > 0 else np.nan)\n",
        "\n",
        "# Store variable-size label masks as an object array\n",
        "np.savez_compressed(\n",
        "\t\"output-test/ecoli_pipeline_results.npz\",\n",
        "\tmasks=np.array(ecoli_masks, dtype=object),\n",
        "\tmean_area=np.array(ecoli_mean_area),\n",
        ")\n",
        "\n",
        "# Plot observed bacterial area over time\n",
        "plt.figure(figsize=(8/2.54, 5/2.54))\n",
        "plt.plot(ecoli_mean_area, lw=1)\n",
        "plt.xlabel(\"Frame\")\n",
        "plt.ylabel(\"Mean segmented bacterial area (px)\")\n",
        "plt.title(\"E. coli area over time\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "8ae1f03a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Nuclear (KTR) pipeline\n"
      ],
      "id": "1f3a0e76"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def seg_nuclei(input_img):\n",
        "\tthresh = sk.filters.threshold_triangle(input_img)\n",
        "\tmask = input_img > thresh\n",
        "\tmask = sk.morphology.remove_small_objects(mask, min_size=60)\n",
        "\tmask = ndimage.binary_fill_holes(mask)\n",
        "\treturn sk.measure.label(mask)\n",
        "\n",
        "\n",
        "def ring_mask_for_label(labeled_nuclei, label_id, ring_width=4):\n",
        "\tnucleus_i = labeled_nuclei == label_id\n",
        "\tif not np.any(nucleus_i):\n",
        "\t\treturn np.zeros_like(nucleus_i, dtype=bool)\n",
        "\n",
        "\tring_i = sk.morphology.binary_dilation(nucleus_i, footprint=sk.morphology.disk(ring_width))\n",
        "\tring_i = np.logical_and(ring_i, labeled_nuclei == 0)\n",
        "\treturn ring_i\n",
        "\n",
        "\n",
        "def measure_nuclear_and_ring_signals(img_nuc, img_ktr, ring_width=4):\n",
        "\tlabeled_nuclei = seg_nuclei(img_nuc)\n",
        "\tprops_nuc = sk.measure.regionprops_table(\n",
        "\t\tlabeled_nuclei,\n",
        "\t\tintensity_image=img_ktr,\n",
        "\t\tproperties=(\"label\", \"area\", \"mean_intensity\"),\n",
        "\t)\n",
        "\n",
        "\tlabels = props_nuc[\"label\"]\n",
        "\tnuc_signal = props_nuc[\"mean_intensity\"]\n",
        "\tring_signal = np.full_like(nuc_signal, np.nan, dtype=float)\n",
        "\n",
        "\tfor i, lab in enumerate(labels):\n",
        "\t\tring_i = ring_mask_for_label(labeled_nuclei, lab, ring_width=ring_width)\n",
        "\t\tif np.any(ring_i):\n",
        "\t\t\tring_signal[i] = np.mean(img_ktr[ring_i])\n",
        "\n",
        "\treturn labeled_nuclei, labels, nuc_signal, ring_signal"
      ],
      "id": "da8cd023",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Path used in previous workshop chapters\n",
        "img_path_KTR = \"/Users/m.wehrens/Data_notbacked/2025_Py-Image-workshop_KTR-example-data/raw/Composite_KTR.tif\"\n",
        "img_KTR = tiff.imread(img_path_KTR)\n",
        "\n",
        "# Example single frame: segmentation + per-nucleus KTR mean\n",
        "t0 = 0\n",
        "img_nuc_0 = img_KTR[t0, 0]\n",
        "img_ktr_0 = img_KTR[t0, 1]\n",
        "\n",
        "labeled_0, labels_0, nuc_0, ring_0 = measure_nuclear_and_ring_signals(img_nuc_0, img_ktr_0, ring_width=4)\n",
        "\n",
        "fig, axs = plt.subplots(1, 2, figsize=(12/2.54, 5/2.54))\n",
        "axs[0].imshow(img_nuc_0, cmap=\"gray\")\n",
        "axs[0].contour(labeled_0 > 0, levels=[0.5], colors=\"r\", linewidths=0.5)\n",
        "axs[0].set_title(\"Nuclear segmentation\")\n",
        "axs[0].axis(\"off\")\n",
        "\n",
        "axs[1].hist(nuc_0, bins=20)\n",
        "axs[1].set_xlabel(\"Nuclear KTR intensity\")\n",
        "axs[1].set_ylabel(\"Count\")\n",
        "axs[1].set_title(\"Per-nucleus means (single frame)\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "fa809704",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Loop over all frames: collect nuclear and cytoplasmic-ring KTR signals\n",
        "n_frames = img_KTR.shape[0]\n",
        "\n",
        "all_nuc_signals = []\n",
        "all_ring_signals = []\n",
        "frame_mean_nuc = []\n",
        "frame_mean_ring = []\n",
        "frame_ratio = []\n",
        "nuclei_masks = []\n",
        "\n",
        "for t in range(n_frames):\n",
        "\timg_nuc_t = img_KTR[t, 0]\n",
        "\timg_ktr_t = img_KTR[t, 1]\n",
        "\n",
        "\tlabeled_t, labels_t, nuc_t, ring_t = measure_nuclear_and_ring_signals(img_nuc_t, img_ktr_t, ring_width=4)\n",
        "\tnuclei_masks.append(labeled_t)\n",
        "\n",
        "\tall_nuc_signals.append(nuc_t)\n",
        "\tall_ring_signals.append(ring_t)\n",
        "\n",
        "\tmean_nuc_t = np.nanmean(nuc_t) if len(nuc_t) > 0 else np.nan\n",
        "\tmean_ring_t = np.nanmean(ring_t) if len(ring_t) > 0 else np.nan\n",
        "\n",
        "\tframe_mean_nuc.append(mean_nuc_t)\n",
        "\tframe_mean_ring.append(mean_ring_t)\n",
        "\tframe_ratio.append(mean_nuc_t / mean_ring_t)\n",
        "\n",
        "np.savez_compressed(\n",
        "\t\"output-test/KTR_pipeline_results.npz\",\n",
        "\tmasks=np.array(nuclei_masks, dtype=object),\n",
        "\tmean_nuclear=np.array(frame_mean_nuc),\n",
        "\tmean_cytoring=np.array(frame_mean_ring),\n",
        "\tratio_nuc_to_cyto=np.array(frame_ratio),\n",
        ")\n",
        "\n",
        "# Plot nuclear and cytoplasmic-ring signals\n",
        "fig, axs = plt.subplots(1, 2, figsize=(14/2.54, 5/2.54))\n",
        "\n",
        "axs[0].plot(frame_mean_nuc, label=\"Nuclear\", lw=1.2)\n",
        "axs[0].plot(frame_mean_ring, label=\"Cytoplasmic ring\", lw=1.2)\n",
        "axs[0].set_xlabel(\"Frame\")\n",
        "axs[0].set_ylabel(\"Mean KTR signal\")\n",
        "axs[0].set_title(\"Average KTR intensity over time\")\n",
        "axs[0].legend()\n",
        "\n",
        "axs[1].plot(frame_ratio, color=\"k\", lw=1.2)\n",
        "axs[1].set_xlabel(\"Frame\")\n",
        "axs[1].set_ylabel(\"Nuclear / Cytoplasmic ring\")\n",
        "axs[1].set_title(\"N:C ratio over time\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "c596f2ae",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Interpretation (as requested in the exercise):\n",
        "when kinase activity is higher, KTR redistributes more to cytoplasm, so the\n",
        "nuclear:cytoplasmic ratio should drop. In this experiment, the ratio dynamics\n",
        "suggest a time-varying kinase activation state.\n",
        "\n",
        "## Optional extension: simple background correction\n"
      ],
      "id": "9d24dfa9"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Estimate per-frame background from mode in KTR channel and recalculate ratio.\n",
        "\n",
        "def frame_mode_uint(img):\n",
        "\timg_u = img.astype(np.uint16)\n",
        "\treturn np.argmax(np.bincount(img_u.ravel()))\n",
        "\n",
        "\n",
        "bg_values = np.array([frame_mode_uint(img_KTR[t, 1]) for t in range(n_frames)], dtype=float)\n",
        "frame_mean_nuc_bg = np.array(frame_mean_nuc) - bg_values\n",
        "frame_mean_ring_bg = np.array(frame_mean_ring) - bg_values\n",
        "\n",
        "# avoid division by non-positive corrected ring signal\n",
        "ratio_bg = np.where(frame_mean_ring_bg > 0, frame_mean_nuc_bg / frame_mean_ring_bg, np.nan)\n",
        "\n",
        "plt.figure(figsize=(8/2.54, 5/2.54))\n",
        "plt.plot(frame_ratio, label=\"Raw ratio\")\n",
        "plt.plot(ratio_bg, label=\"Background-corrected ratio\")\n",
        "plt.xlabel(\"Frame\")\n",
        "plt.ylabel(\"N:C ratio\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "a1786b7a",
      "execution_count": null,
      "outputs": []
    }
  ],
