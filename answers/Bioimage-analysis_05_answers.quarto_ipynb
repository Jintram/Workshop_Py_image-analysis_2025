      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: Workshop Python Image Analysis\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "\n",
        "*Martijn Wehrens, September 2025*\n",
        "\n",
        "## Answers to exercises 05\n"
      ],
      "id": "7c6ff59f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tifffile as tiff\n",
        "\n",
        "import skimage as sk\n",
        "from skimage.util import invert\n",
        "from scipy import ndimage"
      ],
      "id": "541c5cf7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Bacterial filamentation data\n",
        "\n",
        "To do this, we can make use of the functions provided in [the building block page](Bioimage-analysis_05a_Pipelines_buildingblocks.qmd). (These are not re-iterated here.)\n",
        "\n",
        "\n",
        "Let's load the data again:"
      ],
      "id": "867f2c54"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Put the location of the data here.\n",
        "path_ecoli_data = \"/Users/m.wehrens/Data_notbacked/2025_Py-Image-workshop_Filamentation-example-data/pos3crop_timelapse_switch890.98.tif\"\n",
        "\n",
        "# Load data\n",
        "imgs_ecoli = tiff.imread(path_ecoli_data)"
      ],
      "id": "b15d2979",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Show a few example images\n",
        "plt.imshow(invert(imgs_ecoli[10,:,:]))\n",
        "plt.show()"
      ],
      "id": "2982ed0f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Loop over all frames and segment\n",
        "segmasks_ecoli = []\n",
        "mean_areas_ecoli = []\n",
        "\n",
        "for t in range(imgs_ecoli.shape[0]):\n",
        "    current_segmask = seg_bacterium(invert(imgs_ecoli[t]))\n",
        "    segmasks_ecoli.append(current_segmask)\n",
        "\n",
        "    props_t = sk.measure.regionprops(current_segmask)\n",
        "    areas_t = np.array([p.area for p in props_t])\n",
        "    mean_areas_ecoli.append(np.mean(areas_t) if len(areas_t) > 0 else np.nan)\n",
        "\n",
        "# Store masks and summary values\n",
        "np.savez_compressed(\n",
        "    \"output-test/ecoli_pipeline_results.npz\",\n",
        "    segmasks=np.array(segmasks_ecoli, dtype=object),\n",
        "    mean_area=np.array(mean_areas_ecoli),\n",
        ")\n",
        "\n",
        "# Plot observed bacterial areas over time\n",
        "plt.figure(figsize=(9 / 2.54, 5 / 2.54))\n",
        "plt.plot(mean_areas_ecoli, lw=1)\n",
        "plt.xlabel(\"Frame\")\n",
        "plt.ylabel(\"Mean bacterial area (px)\")\n",
        "plt.title(\"E. coli: segmented area over time\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "5b6a8451",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Nuclear data\n",
        "\n",
        "### Segment nuclei and extract nuclear KTR signal for a single image\n"
      ],
      "id": "d0616636"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def seg_nuclei(input_img):\n",
        "    thresh = sk.filters.threshold_triangle(input_img)\n",
        "    mask = input_img > thresh\n",
        "    mask = sk.morphology.remove_small_objects(mask, min_size=60)\n",
        "    mask = ndimage.binary_fill_holes(mask)\n",
        "    result = sk.measure.label(mask)\n",
        "    return result\n",
        "\n",
        "\n",
        "# Path used in earlier chapters\n",
        "img_path_KTR = \"/Users/m.wehrens/Data_notbacked/2025_Py-Image-workshop_KTR-example-data/raw/Composite_KTR.tif\"\n",
        "img_KTR = tiff.imread(img_path_KTR)\n",
        "\n",
        "# Single frame\n",
        "t0 = 0\n",
        "img_nuclei_t0 = img_KTR[t0, 0]\n",
        "img_ktr_t0 = img_KTR[t0, 1]\n",
        "\n",
        "segmask_nuclei_t0 = seg_nuclei(img_nuclei_t0)\n",
        "\n",
        "props_t0 = sk.measure.regionprops_table(\n",
        "    segmask_nuclei_t0,\n",
        "    intensity_image=img_ktr_t0,\n",
        "    properties=(\"label\", \"mean_intensity\", \"area\"),\n",
        ")\n",
        "nuclear_ktr_t0 = props_t0[\"mean_intensity\"]\n",
        "\n",
        "fig, axs = plt.subplots(1, 2, figsize=(12 / 2.54, 5 / 2.54))\n",
        "axs[0].imshow(img_nuclei_t0, cmap=\"gray\")\n",
        "axs[0].contour(segmask_nuclei_t0 > 0, levels=[0.5], colors=\"r\", linewidths=0.5)\n",
        "axs[0].set_title(\"Nuclear segmentation\")\n",
        "axs[0].axis(\"off\")\n",
        "\n",
        "axs[1].hist(nuclear_ktr_t0, bins=20)\n",
        "axs[1].set_xlabel(\"Nuclear KTR signal\")\n",
        "axs[1].set_ylabel(\"Count\")\n",
        "axs[1].set_title(\"Single-frame per-nucleus means\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "8d4c9d72",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Extract nuclear KTR signals over time\n"
      ],
      "id": "35ccb7ba"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def ring_mask_for_label(labeled_nuclei, label_id, ring_width=4):\n",
        "    nucleus_i = labeled_nuclei == label_id\n",
        "    if not np.any(nucleus_i):\n",
        "        return np.zeros_like(nucleus_i, dtype=bool)\n",
        "\n",
        "    ring_i = sk.morphology.binary_dilation(nucleus_i, footprint=sk.morphology.disk(ring_width))\n",
        "    ring_i = np.logical_and(ring_i, labeled_nuclei == 0)\n",
        "    return ring_i\n",
        "\n",
        "\n",
        "n_frames = img_KTR.shape[0]\n",
        "\n",
        "segmasks_nuclei = []\n",
        "all_nuclear_signals = []\n",
        "all_ring_signals = []\n",
        "mean_nuclear_signal = []\n",
        "mean_cytoplasmic_signal = []\n",
        "ratio_nuc_cyto = []\n",
        "\n",
        "for t in range(n_frames):\n",
        "    img_nuclei_t = img_KTR[t, 0]\n",
        "    img_ktr_t = img_KTR[t, 1]\n",
        "\n",
        "    segmask_t = seg_nuclei(img_nuclei_t)\n",
        "    segmasks_nuclei.append(segmask_t)\n",
        "\n",
        "    props_t = sk.measure.regionprops_table(\n",
        "        segmask_t,\n",
        "        intensity_image=img_ktr_t,\n",
        "        properties=(\"label\", \"mean_intensity\", \"area\"),\n",
        "    )\n",
        "\n",
        "    labels_t = props_t[\"label\"]\n",
        "    nuclear_signal_t = props_t[\"mean_intensity\"]\n",
        "    ring_signal_t = np.full_like(nuclear_signal_t, np.nan, dtype=float)\n",
        "\n",
        "    for i, lab in enumerate(labels_t):\n",
        "        mask_ring_i = ring_mask_for_label(segmask_t, lab, ring_width=4)\n",
        "        if np.any(mask_ring_i):\n",
        "            ring_signal_t[i] = np.mean(img_ktr_t[mask_ring_i])\n",
        "\n",
        "    all_nuclear_signals.append(nuclear_signal_t)\n",
        "    all_ring_signals.append(ring_signal_t)\n",
        "\n",
        "    mean_nuc_t = np.nanmean(nuclear_signal_t) if len(nuclear_signal_t) > 0 else np.nan\n",
        "    mean_cyto_t = np.nanmean(ring_signal_t) if len(ring_signal_t) > 0 else np.nan\n",
        "\n",
        "    mean_nuclear_signal.append(mean_nuc_t)\n",
        "    mean_cytoplasmic_signal.append(mean_cyto_t)\n",
        "    ratio_nuc_cyto.append(mean_nuc_t / mean_cyto_t)\n",
        "\n",
        "# Store masks and summaries\n",
        "np.savez_compressed(\n",
        "    \"output-test/KTR_pipeline_results.npz\",\n",
        "    segmasks=np.array(segmasks_nuclei, dtype=object),\n",
        "    mean_nuclear=np.array(mean_nuclear_signal),\n",
        "    mean_cytoplasmic=np.array(mean_cytoplasmic_signal),\n",
        "    ratio_nuc_cyto=np.array(ratio_nuc_cyto),\n",
        ")\n",
        "\n",
        "# Plot nuclear and cytoplasmic signal over time\n",
        "fig, axs = plt.subplots(1, 2, figsize=(14 / 2.54, 5 / 2.54))\n",
        "\n",
        "axs[0].plot(mean_nuclear_signal, lw=1.2, label=\"Nuclear\")\n",
        "axs[0].plot(mean_cytoplasmic_signal, lw=1.2, label=\"Cytoplasmic ring\")\n",
        "axs[0].set_xlabel(\"Frame\")\n",
        "axs[0].set_ylabel(\"Mean KTR signal\")\n",
        "axs[0].set_title(\"KTR signal over time\")\n",
        "axs[0].legend()\n",
        "\n",
        "axs[1].plot(ratio_nuc_cyto, color=\"k\", lw=1.2)\n",
        "axs[1].set_xlabel(\"Frame\")\n",
        "axs[1].set_ylabel(\"Nuclear : cytoplasmic\")\n",
        "axs[1].set_title(\"Nuclear:cytoplasmic ratio\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "039b17ff",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "A likely interpretation is that kinase activity changes over time.\n",
        "When activity is higher, KTR tends to shift to cytoplasm, so the\n",
        "nuclear:cytoplasmic ratio tends to decrease.\n",
        "\n",
        "## Background correction\n"
      ],
      "id": "48ece751"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Simple correction strategy from chapter text: subtract a per-frame mode.\n",
        "\n",
        "def mode_uint(img):\n",
        "    img_u = img.astype(np.uint16)\n",
        "    return np.argmax(np.bincount(img_u.ravel()))\n",
        "\n",
        "\n",
        "bg_values = np.array([mode_uint(img_KTR[t, 1]) for t in range(n_frames)], dtype=float)\n",
        "\n",
        "mean_nuclear_signal_bg = np.array(mean_nuclear_signal) - bg_values\n",
        "mean_cytoplasmic_signal_bg = np.array(mean_cytoplasmic_signal) - bg_values\n",
        "ratio_nuc_cyto_bg = np.where(\n",
        "    mean_cytoplasmic_signal_bg > 0,\n",
        "    mean_nuclear_signal_bg / mean_cytoplasmic_signal_bg,\n",
        "    np.nan,\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9 / 2.54, 5 / 2.54))\n",
        "plt.plot(ratio_nuc_cyto, label=\"Raw ratio\")\n",
        "plt.plot(ratio_nuc_cyto_bg, label=\"Background-corrected ratio\")\n",
        "plt.xlabel(\"Frame\")\n",
        "plt.ylabel(\"Nuclear : cytoplasmic\")\n",
        "plt.title(\"Effect of background correction\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "772efa39",
      "execution_count": null,
      "outputs": []
    }
  ],
